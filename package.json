{
  "name": "ui-system-selector-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server, AI skill, and CLI for discovering, comparing, selecting, and enforcing professional UI design systems in AI coding agents.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "bin/",
    "skills/",
    "schemas/"
  ],
  "bin": {
    "ui-system-selector-mcp": "./bin/mcp-server.js",
    "ui-systems": "./bin/ui-systems.js"
  },
  "scripts": {
    "dev": "npm --prefix gallery run dev",
    "gallery:build": "npm --prefix gallery run build",
    "gallery:preview": "npm --prefix gallery run preview",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "node bin/mcp-server.js",
    "cli": "node bin/ui-systems.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-systems",
    "ui-components",
    "primer",
    "carbon",
    "cloudscape",
    "polaris",
    "spectrum",
    "mantine",
    "ai-agent",
    "coding-agent"
  ],
  "author": "Mousa Hasouneh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MossaJehad/UI-System-Selector-MCP.git"
  },
  "homepage": "https://github.com/MossaJehad/UI-System-Selector-MCP#readme",
  "bugs": {
    "url": "https://github.com/MossaJehad/UI-System-Selector-MCP/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
